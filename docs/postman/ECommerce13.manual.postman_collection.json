{
  "info": {
    "_postman_id": "c0fe4513-08ed-5ef7-8725-4fff034dee9f",
    "name": "ECommerce13 - Manual - Products apagado",
    "description": "Se corre aparte y a mano: primero apagar Products.API (Ctrl+C) y dejar Cart.API levantado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Un runId nuevo por corrida evita choques con datos de corridas anteriores (PRD-003, USR-001).",
          "if (!pm.collectionVariables.get('runId')) {",
          "    pm.collectionVariables.set('runId', Date.now().toString());",
          "}",
          "// Si el request no define su propio X-Correlation-Id, se manda el del environment.",
          "if (!pm.request.headers.has('X-Correlation-Id')) {",
          "    pm.request.headers.add({ key: 'X-Correlation-Id', value: pm.environment.get('correlationId') || 'demo-postman' });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Chequeos comunes a todas las respuestas.",
          "const sent = pm.request.headers.get('X-Correlation-Id');",
          "const sentId = sent ? pm.variables.replaceIn(sent) : null;",
          "const echoed = pm.response.headers.get('X-Correlation-Id');",
          "",
          "pm.test('[común] la respuesta trae X-Correlation-Id', () => {",
          "    pm.expect(echoed, 'header X-Correlation-Id').to.be.a('string').and.not.empty;",
          "    if (sentId) pm.expect(echoed).to.eql(sentId);",
          "});",
          "",
          "if (pm.response.code >= 400) {",
          "    pm.test('[común] el error respeta el contrato ErrorResponse', () => {",
          "        const body = pm.response.json();",
          "        pm.expect(body.status).to.eql(pm.response.code);",
          "        pm.expect(body).to.have.property('errorCode');",
          "        pm.expect(body.errorMessage, 'errorMessage').to.be.a('string').and.not.empty;",
          "        pm.expect(body.correlationId).to.eql(echoed);",
          "    });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "runId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Manual - Products apagado",
      "id": "9f9541f9-14db-5451-9989-03b893a27a65",
      "item": [
        {
          "name": "Agregar al carrito con Products apagado → 500 CRT-005",
          "id": "0c454bb9-5f7a-5491-bc28-ac051c82e145",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{cartUrl}}/api/cart/11111111-2222-3333-4444-555555555555/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n  \"cantidad\": 1\n}"
            },
            "description": "Cart no puede consultar el stock en Products y responde CRT-005 sin exponer el stack trace. El error completo queda en el log de Cart."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 500', () => pm.response.to.have.status(500));",
                  "pm.test('errorCode CRT-005', () => pm.expect(pm.response.json().errorCode).to.eql('CRT-005'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
